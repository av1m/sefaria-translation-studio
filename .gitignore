# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# local translation dumps (never publish drafts accidentally)
/data/versions/*.json
!/data/versions/.gitkeep
/src/data/versions/*.json
!/src/data/versions/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent scratch (tickets / specs)
.scratch/

# Next.js auto-generated agent instructions (local only)
AGENTS.md
CLAUDE.md
